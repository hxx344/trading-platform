# Collects public market data. Only the execution service can reach its socket.
[Unit]
Description=统一交易平台公开行情采集
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=trading-platform-market
Group=trading-platform-market-ipc
EnvironmentFile=-@APP_DIR@/market.env
WorkingDirectory=@APP_DIR@/market
RuntimeDirectory=trading-platform-market
RuntimeDirectoryMode=2750
ExecStart=@NODE@ @APP_DIR@/market/src/market/main.ts --socket /run/trading-platform-market/market.sock
Restart=always
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=@CONF_DIR@ @DATA_DIR@ @IMPORT_DIR@ @UPDATE_DIR@ -/run/trading-platform
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
